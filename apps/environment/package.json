{
  "name": "@t3flare/environment",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src test scripts build.ts alchemy.run.ts stage-files.ts vitest.config.ts",
    "test": "vitest run",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "build": "bun build.ts",
    "prepare:web": "bun run --cwd ../../t3code/apps/web build && git -C ../../t3code checkout -- apps/web/src/routeTree.gen.ts && mkdir -p dist/web && rsync -a --delete --exclude \"*.map\" ../../t3code/apps/web/dist/ dist/web/",
    "deploy": "bun scripts/stage.ts deploy",
    "destroy": "bun scripts/stage.ts destroy",
    "dev": "bun build.ts && wrangler dev -c wrangler.local.jsonc",
    "acceptance": "bun scripts/acceptance.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-do": "catalog:",
    "@t3flare/github-app": "workspace:*",
    "@t3flare/harness-registry": "workspace:*",
    "@t3flare/models": "workspace:*",
    "@t3flare/session-protocol": "workspace:*",
    "@t3flare/workspace-client": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/provider-acp": "workspace:*",
    "@t3tools/provider-acp-registry": "workspace:*",
    "@t3tools/provider-core": "workspace:*",
    "@t3tools/provider-cursor": "workspace:*",
    "@t3tools/provider-muse": "workspace:*",
    "@t3tools/provider-opencode": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/source-control-core": "workspace:*",
    "effect": "catalog:",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "t3": "workspace:*"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.85",
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@distilled.cloud/cloudflare": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "rolldown": "1.2.13",
    "vitest": "5.0.5",
    "wrangler": "4.157.0",
    "@t3flare/sandbox-image": "workspace:*"
  }
}
