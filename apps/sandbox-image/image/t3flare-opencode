#!/bin/sh
# OpenCode over ACP (step 4b, plan §4.2 with review F6 and M0 P2): installs the system configuration the profile wrote
# into this process's home (/etc/opencode outranks user and project files), copies in the synced session snapshot, and
# becomes `opencode acp`. OpenCode drops a configuration statement it cannot read with only a warning in its log, which
# would fail open: a watcher ends the process on any diagnostic about t3flare's file. Nothing goes to stdout.
# SPI-1169: a process on the model relay has its model handle in T3FLARE_MODEL_HANDLE. OpenCode starts without it
# (`env -u` below), so no OpenCode process holds it and a repository's `{env:T3FLARE_MODEL_HANDLE}` finds nothing: the
# key plugin reads it from the start environment of setsid, which started this script (`relay.js` `handleFrom`). The
# watcher and the snapshot loop are this script run again without it. No file holds it.
# SPI-1209: every program is named by its absolute path (the rest are the shell's builtins), the loops' too: this script
# holds the handle (`env -u` itself would otherwise be looked up on PATH), the image puts mise's shims first on PATH and
# /workspace's mise configuration is trusted, so a project could put an `env` or a `mkdir` there.
set -eu
self=${2:-}
if [ "${1:-}" = --t3flare-watch ]; then
  log=$3
  while kill -0 "$self" 2>/dev/null; do
    if /usr/bin/grep -q 'configuration normalization diagnostic.*source=/etc/opencode' "$log" 2>/dev/null; then
      echo "t3flare: OpenCode could not read part of t3flare's configuration; the process was ended" >&2
      /usr/bin/grep 'configuration normalization diagnostic.*source=/etc/opencode' "$log" | /usr/bin/head -3 >&2
      kill -TERM "$self"; exit 0
    fi
    /usr/bin/sleep 1
  done
  exit 0
fi
if [ "${1:-}" = --t3flare-snapshot ]; then
  # The snapshot: a consistent copy (VACUUM INTO reads in one transaction) whenever the database changed, every 15 s.
  snapshot_dir=$3 db=$4 snapshot=$5
  /usr/bin/mkdir -p "$snapshot_dir"; last=""
  while kill -0 "$self" 2>/dev/null; do
    /usr/bin/sleep 15
    [ -f "$db" ] || continue
    now=$(/usr/bin/stat -c %Y "$db" "$db-wal" 2>/dev/null | /usr/bin/sort -n | /usr/bin/tail -1)
    [ "$now" = "$last" ] && continue
    /usr/bin/rm -f "$snapshot_dir/.opencode.db.tmp"
    if /usr/bin/sqlite3 "$db" "VACUUM INTO '$snapshot_dir/.opencode.db.tmp'" 2>/dev/null; then /usr/bin/mv -f "$snapshot_dir/.opencode.db.tmp" "$snapshot"; last=$now; fi
  done
  exit 0
fi
home=/var/lib/t3flare/cli/${T3FLARE_EXEC:?}
/usr/bin/mkdir -p /etc/opencode "$XDG_DATA_HOME/opencode/log"
/usr/bin/install -m 644 "$home/opencode.json" "/etc/opencode/.opencode.$$.json"
/usr/bin/mv -f "/etc/opencode/.opencode.$$.json" /etc/opencode/opencode.json
# Sessions resume from the synced snapshot (plan §7, M0 P5). The snapshot is on agent-writable disk, so what OpenCode
# would trust from it is removed first: saved "always" approvals (durable allow rules) and accounts.
snapshot_dir=/workspace/.t3flare/opencode
snapshot=$snapshot_dir/opencode.db
db=$XDG_DATA_HOME/opencode/opencode.db
if [ -f "$snapshot" ]; then
  /usr/bin/cp "$snapshot" "$db"
  for table in permission account account_state control_account; do /usr/bin/sqlite3 "$db" "DELETE FROM $table" 2>/dev/null || true; done
fi
log=$XDG_DATA_HOME/opencode/log/opencode.log
/usr/bin/env -u T3FLARE_MODEL_HANDLE "$0" --t3flare-watch "$$" "$log" </dev/null >/dev/null &
/usr/bin/env -u T3FLARE_MODEL_HANDLE "$0" --t3flare-snapshot "$$" "$snapshot_dir" "$db" "$snapshot" </dev/null >/dev/null 2>&1 &
exec /usr/bin/env -u T3FLARE_MODEL_HANDLE /opt/t3flare/opencode/opencode acp
