#!/bin/sh
# Claude Code's apiKeyHelper on the model relay (SPI-1168): prints this Claude process's model handle, which its launcher
# (claude-agent-acp) holds only in the environment it started with. Found by the process's marker: the launcher's pid in
# the process's home, then that pid's /proc environ. Writes no file and logs nothing; fails when there is no handle.
set -eu
pid=$(cat "/var/lib/t3flare/cli/${T3FLARE_EXEC:?}/acp.pid")
handle=$(tr '\0' '\n' < "/proc/$pid/environ" | sed -n 's/^T3FLARE_MODEL_HANDLE=//p' | head -n 1)
if [ -z "$handle" ]; then
  echo "t3flare: this Claude Code process has no model handle" >&2
  exit 1
fi
printf '%s\n' "$handle"
