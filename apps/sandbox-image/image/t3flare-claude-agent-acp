#!/bin/sh
# Claude Code over ACP (step 4b, plan §4.1 with M0 P1): installs the managed settings the profile wrote into this
# process's home (/etc/claude-code is the highest settings source, so a repository's .claude/ cannot override a managed
# key), then becomes claude-agent-acp, run by the image's own Node. Nothing goes to stdout: it is the ACP stream.
# SPI-1168: a process on the model relay has its model handle in T3FLARE_MODEL_HANDLE. It stays only in the environment
# this process starts with: the preload drops it from claude-agent-acp's own before it starts claude, so neither claude
# nor its Bash, hooks or helpers inherit it, and no file holds it. The handle helper (t3flare-claude-handle) reads it
# from /proc/<this pid>/environ, by the pid and start time kept in the home. Any command of the same uid can do what
# the helper does (ADR-0016's SPI-1168 refinement): this keeps the handle out of environments, not out of reach.
# SPI-1209: every program is named by its absolute path (the rest are the shell's builtins): this script holds the
# handle, the image puts mise's shims first on PATH and /workspace's mise configuration is trusted, so a project could
# put a `sed` or a `mkdir` there.
set -eu
home=/var/lib/t3flare/cli/${T3FLARE_EXEC:?}
umask 077
# This shell's pid and start time: the pid execs claude-agent-acp below, and the handle helper checks both before
# reading its environment.
printf '%s %s\n' "$$" "$(/usr/bin/sed 's/.*) //' /proc/$$/stat | /usr/bin/cut -d' ' -f20)" > "$home/acp.pid"
/usr/bin/mkdir -p /etc/claude-code
/usr/bin/install -m 644 "$home/managed-settings.json" "/etc/claude-code/.managed-settings.$$"
/usr/bin/mv -f "/etc/claude-code/.managed-settings.$$" /etc/claude-code/managed-settings.json
exec /usr/local/share/mise/installs/node/26.13.0/bin/node --require /opt/t3flare/share/claude-handle-unset.cjs /opt/t3flare/claude/node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js
