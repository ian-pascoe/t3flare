{
  "name": "t3flare",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:workspace": "node scripts/gen-workspace.ts",
    "relock": "node scripts/relock.ts",
    "build:web": "pnpm --filter @t3tools/web run build",
    "check": "vp run --log grouped --concurrency-limit 16 check:all",
    "bump": "node scripts/bump.ts",
    "test:docker": "pnpm --filter @t3flare/environment run test:docker",
    "prepare": "if [ -z \"$CI\" ]; then effect-tsgo patch --typescript; fi && ./scripts/link-tsrslint.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@effect/tsgo": "0.67.1",
    "@maschwenk/tsrslint": "0.1.6",
    "@types/node": "catalog:",
    "oxlint": "1.91.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.12.1"
  }
}
