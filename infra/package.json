{
  "name": "@t3flare/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "ci:setup": "bash -c 'set -a; . \"$HOME/.config/t3flare/dev.env\"; set +a; exec alchemy deploy --config github.ts --stage ci --profile admin' && node allow-actions-prs.ts",
    "ci:destroy": "alchemy destroy --config github.ts --stage ci --profile admin",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "lint": "oxlint --type-aware --deny-warnings github.ts allow-actions-prs.ts github-app-setup.ts src",
    "github-app:setup": "node github-app-setup.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/github": "2.0.0-beta.85",
    "@effect/platform-bun": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "@t3flare/github-app": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "5.0.5"
  }
}
